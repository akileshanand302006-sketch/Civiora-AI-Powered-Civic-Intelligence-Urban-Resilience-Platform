# ============================================================
# CIVIORA PRODUCTION ENVIRONMENT SPECIFICATION & CHECKLIST
# Deployment Targets: Frontend -> Vercel | Backend -> Render
# ============================================================

# ────────────────────────────────────────────────────────────
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel Project Settings)
# ────────────────────────────────────────────────────────────
# Set these in your Vercel Project Dashboard -> Settings -> Environment Variables.
# Vite requires public variables to be prefixed with VITE_.

# The public URL of your deployed Render backend API (do not include trailing slash)
VITE_API_URL=https://civiora-api-6dij.onrender.com/api/v1

# The WebSocket Gateway URL of your deployed Render backend
VITE_WS_URL=https://civiora-api-6dij.onrender.com

# Public Google Maps JavaScript API Key (Restricted by HTTP Referrer on Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=AIzaSyYourProductionGoogleMapsAPIKeyHere

# Optional: Mapbox access token if vector layers enabled
VITE_MAPBOX_TOKEN=pk.eyJ1Ijoi...

# ────────────────────────────────────────────────────────────
# 2. BACKEND API ENVIRONMENT VARIABLES (Render Service: civiora-api)
# ────────────────────────────────────────────────────────────
# Set these in your Render Dashboard -> civiora-api -> Environment.
# (Or automatically provisioned if deploying via render.yaml Blueprint)

NODE_ENV=production
PORT=4000
API_VERSION=v1
APP_NAME=Civiora

# Public URL of your Vercel frontend application
APP_URL=https://civioraai.vercel.app

# Allowed CORS origins (comma-separated list for custom domains; *.vercel.app is handled dynamically)
WS_CORS_ORIGIN=https://civioraai.vercel.app,http://localhost:5173,http://localhost:5174

# MongoDB Atlas Production Cluster Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@civiora-db.se5b7wx.mongodb.net/civiora?retryWrites=true&w=majority&appName=civiora-db

# Redis URL (Render Redis instance or Upstash / Redis Cloud)
# If Redis is omitted, in-memory fallback is active for local/light loads
REDIS_URL=redis://red-xxxxxxxx:6379

# Cryptographic secrets (Minimum 32 characters each)
JWT_ACCESS_SECRET=generate-a-secure-32-character-random-string-access
JWT_REFRESH_SECRET=generate-a-secure-32-character-random-string-refresh
JWT_MFA_SECRET=generate-a-secure-32-character-random-string-mfa
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Private AI Service URL on Render (use Render Private Service name if in same region)
AI_SERVICE_URL=http://civiora-ai:8000
AI_SERVICE_KEY=generate-a-shared-private-token-between-services

# Cloudinary Storage for Incident Evidence
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=civicpulse_evidence

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Resend Email Delivery & Municipal Dossier Dispatch
RESEND_API_KEY=re_your_private_resend_api_key_here
RESEND_FROM_EMAIL=reports@your-domain.gov
MUNICIPAL_RECEIVER_EMAIL=akileshanand302006@gmail.com
EMAIL_DELIVERY_ENABLED=true
FRONTEND_URL=https://civioraai.vercel.app

# ────────────────────────────────────────────────────────────
# 3. AI SERVICE ENVIRONMENT VARIABLES (Render Service: civiora-ai)
# ────────────────────────────────────────────────────────────
ENVIRONMENT=production
PORT=8000
CORS_ORIGINS=https://civioraai.vercel.app,http://localhost:5173
AI_API_KEY=generate-a-shared-private-token-between-services
