# ============================================================
# CivicPulse Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example.
# ============================================================

# ── General ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_VERSION=v1
APP_NAME=CivicPulse
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# ── MongoDB Atlas ──────────────────────────────────────────────
# MongoDB Atlas Connection URI:
# For production/Atlas: mongodb+srv://<username>:<password>@civiora-db.se5b7wx.mongodb.net/civiora?retryWrites=true&w=majority&appName=civiora-db
# Ensure network access whitelist in Atlas includes your IP or 0.0.0.0/0
MONGODB_URI=mongodb+srv://<username>:<password>@civiora-db.se5b7wx.mongodb.net/civiora?retryWrites=true&w=majority&appName=civiora-db

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
JWT_REFRESH_EXPIRY=7d
JWT_MFA_SECRET=change-me-to-yet-another-random-64-char-string
JWT_MFA_EXPIRY=5m

# ── Argon2 ───────────────────────────────────────────────────
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ── Object Storage (Cloudinary) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=civicpulse_evidence

# ── Map Provider ─────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token

# ── AI Service ───────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=change-me-shared-service-key

# ── Email (Resend / SendGrid) ────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_your-api-key
EMAIL_FROM=noreply@civicpulse.app

# ── WebSocket ────────────────────────────────────────────────
WS_CORS_ORIGIN=http://localhost:5173

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ── Sentry / Monitoring (optional) ──────────────────────────
# SENTRY_DSN=https://your-sentry-dsn
