# ============================================================
# Civiora Web Frontend — Environment Configuration
# ============================================================

# Google Maps Platform Key for Maps JavaScript API, Places API, and Geocoding API
# Set HTTP referrer restrictions in Google Cloud Console:
# - http://localhost:5173/*
# - http://127.0.0.1:5173/*
# - https://yourproductiondomain.com/*
VITE_GOOGLE_MAPS_API_KEY=AIzaSyYourWebGoogleMapsKeyHere

# Backend API proxy URL
# Local: http://localhost:4000/api/v1
# Production (Render): https://civiora-api-6dij.onrender.com/api/v1
VITE_API_URL=https://civiora-api-6dij.onrender.com/api/v1
